# Local image volumes are large and may be subject to their own distribution
# terms. Keep only the small, reproducibility-critical split files in Git.
data/*
!data/amos_splits/
!data/amos_splits/*.txt
!data/Synapse_npy/
data/Synapse_npy/*
!data/Synapse_npy/splits/
!data/Synapse_npy/splits/*.txt

# Runtime outputs
model/
logs/
runs/
visual_results/

# Python/editor artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db
